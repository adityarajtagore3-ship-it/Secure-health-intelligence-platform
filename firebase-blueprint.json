{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account information for patients and doctors.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique identifier for the user." },
        "email": { "type": "string", "description": "Email address of the user." },
        "displayName": { "type": "string", "description": "Full name of the user." },
        "photoURL": { "type": "string", "description": "Profile picture URL." },
        "role": { "type": "string", "enum": ["patient", "doctor"], "description": "System role." },
        "bio": { "type": "string", "description": "Doctor's bio or patient's general info." },
        "specialty": { "type": "string", "description": "Doctor's specialty." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "HealthMetric": {
      "title": "Health Metric",
      "description": "Historical health data points (heart rate, steps, etc.).",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["heart_rate", "steps", "sleep", "blood_pressure", "weight"] },
        "value": { "type": "number" },
        "unit": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "type", "value", "timestamp"]
    },
    "Consultation": {
      "title": "Medical Consultation",
      "description": "Records of consultations between patients and doctors.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "doctorId": { "type": "string" },
        "status": { "type": "string", "enum": ["scheduled", "completed", "cancelled"] },
        "notes": { "type": "string" },
        "aiSummary": { "type": "string", "description": "AI-generated summary of the session." },
        "startTime": { "type": "string", "format": "date-time" },
        "endTime": { "type": "string", "format": "date-time" }
      },
      "required": ["patientId", "doctorId", "status", "startTime"]
    },
    "Prediction": {
      "title": "AI Diagnosis Prediction",
      "description": "AI-generated health insights and risk scores.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "category": { "type": "string" },
        "probability": { "type": "number" },
        "insight": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Global user profiles."
    },
    "/health_metrics/{metricId}": {
      "schema": "HealthMetric",
      "description": "Time-series health data."
    },
    "/consultations/{consultationId}": {
      "schema": "Consultation",
      "description": "Patient-doctor consultation sessions."
    },
    "/predictions/{predictionId}": {
      "schema": "Prediction",
      "description": "AI-generated health insights."
    }
  }
}
